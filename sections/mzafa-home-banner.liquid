{{ 'mzafa-clone-styles.css' | asset_url | stylesheet_tag }}

<div class="mzafa-clone">
  <section class="mzafa-banner">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '100vw' }}
    {%- else -%}
      <div class="mzafa-placeholder"><span>Banner Image — 16:9</span></div>
    {%- endif -%}
    <div class="mzafa-banner-scrim"></div>
    <div class="mzafa-banner-copy">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '#' }}" class="mzafa-underline-link">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "MZAFA Full Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Statement Rings" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "MZAFA Full Banner" }]
}
{% endschema %}
