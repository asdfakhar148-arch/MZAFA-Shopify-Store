{{ 'mzafa-clone-styles.css' | asset_url | stylesheet_tag }}
{{ 'mzafa-header.css' | asset_url | stylesheet_tag }}

<div class="mzafa-clone">
  <section class="mzafa-hero">
    <div class="mzafa-hero-media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw' }}
      {%- else -%}
        <div class="mzafa-placeholder"><span>Hero Image — 16:9</span></div>
      {%- endif -%}
      <div class="mzafa-hero-scrim"></div>
      <div class="mzafa-hero-copy">
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="mzafa-btn mzafa-btn--light">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>

      {%- assign mzafa_has_social = false -%}
      {%- if section.settings.whatsapp_link != blank or section.settings.facebook_link != blank or section.settings.youtube_link != blank or section.settings.instagram_link != blank -%}
        {%- assign mzafa_has_social = true -%}
      {%- endif -%}
      {%- if mzafa_has_social -%}
        <div class="mzafa-hero-social">
          {%- if section.settings.whatsapp_link != blank -%}
            <a href="{{ section.settings.whatsapp_link }}" aria-label="WhatsApp" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24"><path d="M17 14.5c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.37-1.46-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.6-.91-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z"/><path d="M12 2a10 10 0 0 0-8.55 15.15L2 22l4.98-1.4A10 10 0 1 0 12 2z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook_link != blank -%}
            <a href="{{ section.settings.facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24"><path d="M15 8h2V5h-2c-1.66 0-3 1.34-3 3v2H10v3h2v7h3v-7h2.2l.8-3H15V8c0-.28.22-.5.5-.5H15z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_link != blank -%}
            <a href="{{ section.settings.youtube_link }}" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="M10 9.5v5l4.5-2.5z" fill="#2B2620" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_link != blank -%}
            <a href="{{ section.settings.instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor"/><circle cx="17.2" cy="6.8" r="1.1"/></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "MZAFA Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hooks & Talons" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Social icons (bottom right)" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" },
    { "type": "url", "id": "facebook_link", "label": "Facebook link" },
    { "type": "url", "id": "youtube_link", "label": "YouTube link" },
    { "type": "url", "id": "instagram_link", "label": "Instagram link" }
  ],
  "presets": [{ "name": "MZAFA Hero" }]
}
{% endschema %}
