{{ 'mzafa-clone-styles.css' | asset_url | stylesheet_tag }}

<div class="mzafa-clone">
  <section class="mzafa-grid3">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="mzafa-grid3-card"
        style="
          --mzafa-grid3-title-x: {{ block.settings.title_horizontal }}%;
          --mzafa-grid3-title-y: {{ block.settings.title_vertical }}%;
          --mzafa-grid3-link-x: {{ block.settings.link_horizontal }}%;
          --mzafa-grid3-link-y: {{ block.settings.link_vertical }}%;
          --mzafa-grid3-title-size: {{ block.settings.title_font_size }}px;
          --mzafa-grid3-title-size-mobile: {{ block.settings.title_font_size_mobile }}px;
          --mzafa-grid3-link-size: {{ block.settings.link_font_size }}px;
          --mzafa-grid3-link-size-mobile: {{ block.settings.link_font_size_mobile }}px;
        "
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw' }}
        {%- else -%}
          <div class="mzafa-placeholder"><span>Card Image — 4:5</span></div>
        {%- endif -%}
        <div class="mzafa-grid3-scrim"></div>
        {%- if block.settings.title != blank -%}
          <h3 class="mzafa-grid3-title">{{ block.settings.title }}</h3>
        {%- endif -%}
        {%- if block.settings.link_label != blank -%}
          <span class="mzafa-grid3-link mzafa-underline-link">{{ block.settings.link_label }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </section>
</div>

{% schema %}
{
  "name": "MZAFA Collection Grid",
  "tag": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "card",
      "name": "Grid card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Collection Name" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "header", "content": "Title position and size" },
        { "type": "range", "id": "title_horizontal", "min": 5, "max": 95, "step": 1, "unit": "%", "label": "Title horizontal position", "default": 50 },
        { "type": "range", "id": "title_vertical", "min": 5, "max": 95, "step": 1, "unit": "%", "label": "Title vertical position", "default": 32 },
        { "type": "range", "id": "title_font_size", "min": 12, "max": 96, "step": 2, "unit": "px", "label": "Title size on desktop", "default": 40 },
        { "type": "range", "id": "title_font_size_mobile", "min": 12, "max": 72, "step": 2, "unit": "px", "label": "Title size on mobile", "default": 32 },
        { "type": "header", "content": "Link position and size" },
        { "type": "range", "id": "link_horizontal", "min": 5, "max": 95, "step": 1, "unit": "%", "label": "Link horizontal position", "default": 50 },
        { "type": "range", "id": "link_vertical", "min": 5, "max": 95, "step": 1, "unit": "%", "label": "Link vertical position", "default": 44 },
        { "type": "range", "id": "link_font_size", "min": 10, "max": 32, "step": 1, "unit": "px", "label": "Link size on desktop", "default": 15 },
        { "type": "range", "id": "link_font_size_mobile", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "Link size on mobile", "default": 14 }
      ]
    }
  ],
  "presets": [
    {
      "name": "MZAFA Collection Grid",
      "blocks": [
        { "type": "card", "settings": { "title": "Signet" } },
        { "type": "card", "settings": { "title": "Talon" } },
        { "type": "card", "settings": { "title": "Monolith" } }
      ]
    }
  ]
}
{% endschema %}

