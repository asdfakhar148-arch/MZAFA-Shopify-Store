{{ 'mzafa-clone-styles.css' | asset_url | stylesheet_tag }}

{%- assign story_transition_height = section.blocks.size | times: 90 -%}
{%- assign story_scroll_height = story_transition_height | plus: 100 -%}

<div class="mzafa-clone">
  <section
    class="mzafa-story"
    data-mzafa-story
    style="--mzafa-story-height: {{ story_scroll_height }}svh;"
    aria-label="MZAFA collections"
  >
    <div class="mzafa-story__sticky">
      {%- for block in section.blocks -%}
        {% liquid
          assign description = block.settings.description
          if description == blank
            assign description = 'A study in dark light. Quiet power, modern grace, crafted for the everyday edit.'
          endif
        %}
        <article
          class="mzafa-story-card{% if forloop.first %} is-active{% endif %}"
          data-mzafa-story-card
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="mzafa-story-card__inner">
            <div class="mzafa-story-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 42vw, 100vw' }}
              {%- else -%}
                <div class="mzafa-placeholder"><span>Card Image — 4:5</span></div>
              {%- endif -%}
            </div>

            <div class="mzafa-story-card__copy">
              {%- if block.settings.title != blank -%}
                <h2>{{ block.settings.title }}</h2>
              {%- endif -%}
              <div class="mzafa-story-card__description rte">{{ description }}</div>
              {%- if block.settings.link_label != blank -%}
                <a class="mzafa-story-card__button" href="{{ block.settings.link | default: '#' }}">
                  {{ block.settings.link_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>
</div>

<script src="{{ 'mzafa-story-scroll.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "MZAFA Collection Story",
  "tag": "section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "card",
      "name": "Collection slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Collection Name" },
        { "type": "richtext", "id": "description", "label": "Body text", "default": "<p>A study in dark light. Quiet power, modern grace, crafted for the everyday edit.</p>" },
        { "type": "text", "id": "link_label", "label": "Button label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MZAFA Collection Story",
      "blocks": [
        { "type": "card", "settings": { "title": "Modern", "link_label": "Explore" } },
        { "type": "card", "settings": { "title": "Talon", "link_label": "Explore" } },
        { "type": "card", "settings": { "title": "Monolith", "link_label": "Explore" } }
      ]
    }
  ]
}
{% endschema %}

